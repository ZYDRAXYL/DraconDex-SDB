node_modules/
*.log

# Databases. Nothing in this repo should ever hold real user content — the
# schema is the contract, never the data.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets — none are committed and none should be.
.env
.env.*
*.pem
*.key
# No npm dependencies here: the package.json only carries scripts, so the
# package-lock.json that `npm install` (DEV's scripts/setup.ps1) writes is
# empty. Drop this line if this repo ever gains dependencies — then the lock
# belongs in git.
package-lock.json
