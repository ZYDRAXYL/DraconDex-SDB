{
  "kind": "classifier",
  "templates": [
    {
      "id": "classifier.characterWiki",
      "default": true,
      "for": [
        "character"
      ],
      "name": {
        "t": "tplClsCharWiki"
      },
      "description": {
        "t": "tplClsCharWikiD"
      },
      "preset": {
        "catType": "character",
        "fields": [
          {
            "key": "role",
            "name": {
              "t": "artFldRole"
            },
            "type": "select",
            "options": {
              "choices": [
                {
                  "t": "roleProtagonist"
                },
                {
                  "t": "roleAntagonist"
                },
                {
                  "t": "roleSupport"
                }
              ]
            }
          },
          {
            "key": "age",
            "name": {
              "t": "artFldAge"
            },
            "type": "number"
          },
          {
            "key": "personality",
            "name": {
              "t": "artFldPersonality"
            },
            "type": "textarea"
          },
          {
            "key": "goal",
            "name": {
              "t": "artFldGoal"
            },
            "type": "text"
          }
        ]
      },
      "page": [
        {
          "component": "classifier.spotlight"
        },
        {
          "type": "columns",
          "children": [
            [
              {
                "component": "classifier.view",
                "config": {
                  "preset": "grid"
                }
              }
            ],
            [
              {
                "component": "classifier.breakdown",
                "config": {
                  "field": "role"
                }
              }
            ]
          ]
        },
        {
          "component": "core.related"
        }
      ],
      "itemPage": [
        {
          "component": "core.infobox",
          "config": {
            "dock": "right",
            "layout": "table",
            "fields": [
              "role",
              "age",
              "goal"
            ]
          }
        },
        {
          "component": "item.body"
        },
        {
          "component": "core.related"
        }
      ]
    },
    {
      "id": "classifier.characterSheet",
      "for": [
        "character"
      ],
      "name": {
        "t": "tplClsCharSheet"
      },
      "description": {
        "t": "tplClsCharSheetD"
      },
      "preset": {
        "catType": "character",
        "fields": [
          {
            "key": "level",
            "name": {
              "t": "pfLevel"
            },
            "type": "number"
          },
          {
            "key": "hp",
            "name": "HP",
            "type": "number",
            "levelable": true
          },
          {
            "key": "mp",
            "name": "MP",
            "type": "number",
            "levelable": true
          },
          {
            "key": "role",
            "name": {
              "t": "artFldRole"
            },
            "type": "select",
            "options": {
              "choices": [
                {
                  "t": "roleProtagonist"
                },
                {
                  "t": "roleAntagonist"
                },
                {
                  "t": "roleSupport"
                }
              ]
            }
          },
          {
            "key": "backstory",
            "name": {
              "t": "artFldBackstory"
            },
            "type": "textarea"
          }
        ]
      },
      "page": [
        {
          "component": "classifier.view",
          "config": {
            "preset": "table"
          }
        },
        {
          "component": "classifier.breakdown",
          "config": {
            "field": "role"
          }
        }
      ],
      "itemPage": [
        {
          "component": "core.stats",
          "config": {
            "tiles": [
              {
                "field": "level"
              },
              {
                "field": "hp"
              },
              {
                "field": "mp"
              }
            ]
          }
        },
        {
          "component": "core.infobox",
          "config": {
            "dock": "full",
            "layout": "stacked",
            "fields": [
              "role"
            ]
          }
        },
        {
          "component": "item.body"
        },
        {
          "component": "core.related"
        }
      ]
    },
    {
